# Copy to .env. Every value below has a working local default, so .env is optional
# for local development. None of these are third-party credentials.

# Postgres from docker-compose.yml (local-only password).
DATABASE_URL=postgresql://cw:cw_local_dev@localhost:5432/code_workspace

# Redis from docker-compose.yml.
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
# Browser origin allowed to call the API (CORS and WebSocket origin check).
WEB_ORIGIN=http://localhost:3000
# Salt for hashing client IPs in execution records. Set a random value in production.
CLIENT_HASH_SALT=local-dev-salt

# Worker
# Parallel sandboxes per worker process.
WORKER_CONCURRENCY=2
# Optional hardened OCI runtime, e.g. "runsc" for gVisor. Empty uses Docker's default (runc).
SANDBOX_RUNTIME=
# Docker Engine endpoint. Empty uses the platform default (named pipe on Windows, socket on Linux/macOS).
DOCKER_HOST=

# Optional AI assistant (Google Gemini). Read only by the API, never sent to the browser.
# Get a key at https://aistudio.google.com/apikey. Empty turns the assistant off.
GEMINI_API_KEY=
# Models tried in order; each has its own quota (free tier: about 20 answers a day
# for the larger ones). Empty uses the built-in list, best first.
GEMINI_MODELS=
# Fast models that answer everyday questions first (about 2 s to the first word).
# Deep reviews ("find bugs", "improve") use GEMINI_MODELS first. Empty uses the defaults.
GEMINI_FAST_MODELS=

# Web (exposed to the browser)
NEXT_PUBLIC_API_URL=http://localhost:4000
