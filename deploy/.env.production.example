# Production settings for deploy/docker-compose.prod.yml. setup-server.sh writes
# deploy/.env.production from this template with generated secrets. The real
# file is git-ignored and must never be committed.

# Canonical hostname. www.<host> redirects to it. Caddy gets the TLS certificate.
PUBLIC_HOST=writecode.in

# Generated on the server (openssl rand). Not third-party credentials.
POSTGRES_PASSWORD=
CLIENT_HASH_SALT=

# Group owning /var/run/docker.sock on the host: stat -c %g /var/run/docker.sock
DOCKER_GID=

# Empty uses Docker's default runtime (runc) with the sandbox's own restrictions
# (no network, non-root, no capabilities, read-only root, resource limits).
# runsc (gVisor) adds a user-space kernel, but it does not expose kernel wait
# channels, so "waiting for input" cannot be detected: typed-input waits then
# count against the run time limit. Verified with gVisor release-20260921.0.
SANDBOX_RUNTIME=
# Optional AI assistant (Google Gemini, https://aistudio.google.com/apikey).
# Empty turns the assistant off; everything else works. Never commit the real key.
GEMINI_API_KEY=
# Models tried in order; each has its own quota (free tier: about 20 answers a day
# for the larger ones). Empty uses the built-in list, best first.
GEMINI_MODELS=
# Fast models that answer everyday questions first (about 2 s to the first word).
# Deep reviews ("find bugs", "improve") use GEMINI_MODELS first. Empty uses the defaults.
GEMINI_FAST_MODELS=

# Optional camera relay for interviews (the "turn" service). Leave TURN_SECRET empty to run
# without it. The secret is generated on the server (openssl rand -hex 32), never committed.
# TURN_EXTERNAL_IP is the server's public address; TURN_URLS is what browsers connect to.
# Open 3478/udp, 3478/tcp and 49160-49259/udp in the firewall.
TURN_SECRET=
TURN_EXTERNAL_IP=
TURN_URLS=turn:writecode.in:3478?transport=udp,turn:writecode.in:3478?transport=tcp

# Programs run at the same time (each gets 1 CPU): about one per vCPU.
WORKER_CONCURRENCY=2
# Debug sessions open at the same time. They mostly sit paused and use 512 MB
# each: 2 on a 4 GB machine, 4 on 8 GB (e.g. Hostinger KVM 2).
DEBUG_CONCURRENCY=2
