# Production settings for deploy/docker-compose.prod.yml. setup-server.sh writes
# deploy/.env.production from this template with generated secrets. The real
# file is git-ignored and must never be committed.

# Canonical hostname. www.<host> redirects to it. Caddy gets the TLS certificate.
PUBLIC_HOST=writecode.in

# Generated on the server (openssl rand). Not third-party credentials.
POSTGRES_PASSWORD=
CLIENT_HASH_SALT=

# Group owning /var/run/docker.sock on the host: stat -c %g /var/run/docker.sock
DOCKER_GID=

# Empty uses Docker's default runtime (runc) with the sandbox's own restrictions
# (no network, non-root, no capabilities, read-only root, resource limits).
# runsc (gVisor) adds a user-space kernel, but it does not expose kernel wait
# channels, so "waiting for input" cannot be detected: typed-input waits then
# count against the run time limit. Verified with gVisor release-20260921.0.
SANDBOX_RUNTIME=
WORKER_CONCURRENCY=2
DEBUG_CONCURRENCY=2
