# Reverse proxy for Code Workspace.
#
# PUBLIC_HOST is the canonical hostname (e.g. writecode.in). Caddy obtains and
# renews its TLS certificate automatically and redirects HTTP to HTTPS. For
# local staging, PUBLIC_HOST=localhost uses Caddy's internal CA instead.
# Only this container publishes ports; the API, worker, Redis and Postgres are
# on private networks.

# Clients are not trusted proxies, so Caddy replaces any X-Forwarded-For they send
# with their real address; the API's per-client rate limits rely on that.
# (Let's Encrypt does not require an account email, so none is configured.)

{
	servers {
		# HTTP/3 runs over UDP, which many mobile and home networks throttle; measured from
		# India it made the first load 2-3x slower than HTTP/2, so it is not offered.
		protocols h1 h2
	}
}

# Container health check only: plain HTTP on a port that is not published.
:8081 {
	respond /healthz "ok" 200
}

www.{$PUBLIC_HOST} {
	redir https://{$PUBLIC_HOST}{uri} permanent
}

{$PUBLIC_HOST} {
	encode zstd gzip

	# The frame a web project (HTML, CSS, JavaScript) is previewed in. The page in it is
	# someone's own code, so the frame is cut off from this site: "sandbox" gives it an
	# origin of its own wherever it is opened, where it can read nothing of the site's
	# storage. In return it may load what any web page may (a CDN, a font, a picture).
	@preview path /preview.html
	header @preview {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "sandbox allow-scripts allow-forms allow-modals allow-popups; default-src * data: blob: 'unsafe-inline' 'unsafe-eval'; frame-ancestors 'self'"
		-Server
	}

	@site not path /preview.html
	header @site {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		# The IDE and API share this origin. Monaco runs web workers from blobs.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' wss://{$PUBLIC_HOST}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# API and live execution events (WebSocket upgrade is proxied transparently).
	@backend path /api/* /ws /ws-live
	handle @backend {
		reverse_proxy api:4000 {
			health_uri /api/v1/health/live
			health_interval 15s
		}
	}

	# Liveness of the proxy itself, for external uptime checks.
	handle /healthz {
		respond "ok" 200
	}

	# The IDE and the landing pages: static files exported by Next.js.
	handle {
		root * /srv
		@immutable path /_next/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		# The editor's files: their address carries the editor's version.
		@editor path_regexp editor ^/monaco/\d[^/]*/
		header @editor Cache-Control "public, max-age=31536000, immutable"
		# Next.js page data files (*.txt) are for the app, not for search results.
		@payload path_regexp payload ^/(?:.*/)?(?:__next\.|[a-z0-9-]+\.txt$)
		header @payload X-Robots-Tag "noindex"
		try_files {path} {path}.html
		# The image ships .zst and .gz copies compressed at maximum level at build time.
		file_server {
			precompressed zstd gzip
		}
	}

	# Addresses that do not exist get a real 404 page, so search engines do not index them.
	handle_errors 404 {
		root * /srv
		rewrite * /404.html
		file_server {
			precompressed zstd gzip
		}
	}

	log {
		output stdout
		format json
	}
}
